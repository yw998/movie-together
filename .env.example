# Server-side PostgreSQL connection only. Never expose this as a VITE_* variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Browser-safe Supabase Auth configuration. The publishable key is designed for
# frontend use; access is enforced by Row Level Security. Never use a secret or
# service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Canonical origin used by confirmation and password-recovery emails. Production
# falls back to the current Vercel domain, but setting this explicitly makes a
# future custom-domain change configuration-only.
VITE_PUBLIC_SITE_URL=https://movie-together-nu.vercel.app

# Optional until CAPTCHA is enabled in Supabase Auth. This is a browser-safe
# Cloudflare Turnstile site key; the secret key belongs only in Supabase.
VITE_TURNSTILE_SITE_KEY=

# Keep the English interface hidden until the bilingual release checklist is approved.
VITE_ENABLE_ENGLISH_UI=false

# Local Supabase CLI deployment only. Generate a personal access token in the
# Supabase account dashboard. Never use either value in a VITE_* variable.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=sbp_YOUR_PERSONAL_ACCESS_TOKEN
