# Server-side PostgreSQL connection only. Never expose this as a VITE_* variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Browser-safe Supabase Auth configuration. The publishable key is designed for
# frontend use; access is enforced by Row Level Security. Never use a secret or
# service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
